{
  "name": "@yahaha-studio/kichi-forwarder",
  "version": "0.1.2-beta.37",
  "homepage": "https://github.com/Yahaha-Studio/kichi-forwarder#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yahaha-Studio/kichi-forwarder.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "publishConfig": {
    "access": "public"
  },
  "description": "Native OpenClaw plugin for Kichi World with direct avatar control, status sync, timers, notes, and music tools",
  "files": [
    "README.md",
    "dist/",
    "index.ts",
    "openclaw.plugin.json",
    "skills/",
    "src/"
  ],
  "openclaw": {
    "extensions": [
      "./index.ts"
    ],
    "runtimeExtensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.4.25",
      "minGatewayVersion": "2026.4.25"
    },
    "build": {
      "openclawVersion": "2026.6.33",
      "pluginSdkVersion": "2026.6.33"
    },
    "install": {
      "clawhubSpec": "clawhub:@yahaha-studio/kichi-forwarder",
      "npmSpec": "@yahaha-studio/kichi-forwarder",
      "defaultChoice": "clawhub"
    }
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@yahaha-studio/kichi-core": "0.1.2-beta.37"
  },
  "peerDependencies": {
    "openclaw": ">=2026.4.25"
  }
}
